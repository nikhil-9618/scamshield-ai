# ---------------------------------------------------------------------------
# ScamShield AI environment template. Copy to `.env` and fill in real values.
# NEVER commit `.env` or any real credential. No provider key is required to run
# the stack: unavailable integrations degrade explicitly (see docs/architecture.md).
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side base URL used by Next.js to reach the API (not exposed to browsers)
API_INTERNAL_URL=http://localhost:4000

# --- API -------------------------------------------------------------------
PORT=4000
APP_ORIGIN=http://localhost:3000
# Comma separated allowlist for CORS (no wildcards)
CORS_ORIGINS=http://localhost:3000
ENABLE_API_DOCS=true

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://scamshield:scamshield@localhost:5432/scamshield?schema=public

# --- Redis / queue ---------------------------------------------------------
# Leave empty to run scans inline and use in-memory rate limiting.
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=2

# --- Sessions & crypto -----------------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# 32 random bytes, base64. Generate: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=ss_session
CSRF_COOKIE_NAME=ss_csrf
# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
SCAN_THROTTLE_LIMIT=20
REPORT_THROTTLE_LIMIT=5

# --- AI engine -------------------------------------------------------------
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT_MS=8000
AI_ENGINE_ENABLED=true

# --- LLM (optional) --------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Without a key the product
# falls back to a clearly labelled deterministic explanation.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000

# --- Threat intelligence (all optional) ------------------------------------
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_ENABLED=true
PHISHTANK_ENABLED=false
THREAT_INTEL_TIMEOUT_MS=4000
# Development-only deterministic fixtures. Refused when NODE_ENV=production.
THREAT_INTEL_DEV_FIXTURES=false

# --- Email (optional) -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ScamShield AI <no-reply@scamshield.local>
EMAIL_ENABLED=false

# --- First deploy bootstrap (optional) -------------------------------------
# Creates the first admin only when no admin exists. Required on platforms
# without shell access (Render free). Remove the password after first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Seed (development only) ----------------------------------------------
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@scamshield.local
SEED_ADMIN_PASSWORD=ChangeMe!ScamShield2026
